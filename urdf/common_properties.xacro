<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="chassis_grey"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="caster_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="lidar_red"><color rgba="0.7 0.1 0.1 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.1 0.3 0.8 1.0"/></material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
        izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
        iyy="${(1/12) * mass * (3*r*r + h*h)}" iyz="0.0"
        izz="${0.5 * mass * r * r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass r">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4 * mass * r * r}" ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * r * r}" iyz="0.0"
        izz="${0.4 * mass * r * r}"/>
    </inertial>
  </xacro:macro>

</robot>
